{
  "name": "queue-protocol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QUEUE — a paid slot market for agent work on NEAR",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm -w @queue/server run dev",
    "dev:web": "npm -w @queue/web run dev",
    "build": "npm -w @queue/core run build && npm -w @queue/server run build && npm -w @queue/web run build",
    "build:pages": "node --import tsx scripts/build-pages.mjs",
    "preview:pages": "npx -w @queue/web vite preview --outDir dist-pages --port 4179 --strictPort",
    "verify:pages": "node --import tsx scripts/build-pages.mjs && node scripts/verify-pages.mjs",
    "start": "npm -w @queue/server run start",
    "test": "npm -w @queue/core run test && npm -w @queue/ledger run test && npm -w @queue/server run test && npm -w @queue/web run test && npm -w @queue/client run test",
    "test:contract": "cd contracts/queue && cargo test",
    "build:contract": "cd contracts/queue && cargo build --target wasm32-unknown-unknown --release",
    "deploy:testnet": "node scripts/deploy.mjs",
    "demo:onchain": "tsx scripts/onchain-demo.ts",
    "verify": "bash scripts/verify.sh",
    "verify:onchain": "node scripts/verify-onchain.mjs",
    "verify:artifact": "node --import tsx scripts/verify-artifact.mjs",
    "verify:secrets": "node scripts/secret-scan.mjs",
    "seed": "node scripts/seed-local.mjs",
    "typecheck": "npm -w @queue/core run typecheck && npm -w @queue/ledger run typecheck && npm -w @queue/server run typecheck && npm -w @queue/web run typecheck",
    "nearai:check": "tsx scripts/season/nearai-check.ts",
    "season:setup": "tsx scripts/season/setup.ts",
    "season:sim": "tsx scripts/season/season.ts --sim --minutes 30",
    "season:testnet": "tsx scripts/season/season.ts --testnet --minutes 30",
    "verify:season": "tsx scripts/season/verify-season.ts",
    "test:contract-v2": "cd contracts/queue-v2 && cargo test",
    "build:contract-v2": "cd contracts/queue-v2 && cargo build --target wasm32-unknown-unknown --release",
    "test:season": "node --import tsx --test scripts/season/agents.test.ts scripts/season/nearai.test.ts",
    "verify:v2-deployed": "bash scripts/season/verify-v2-deployed.sh",
    "verify:v1-deployed": "bash scripts/repro-build.sh contracts/queue market.queue-demo.testnet",
    "monitor": "node scripts/monitor.mjs",
    "film:voice": "node scripts/build-voiceover.mjs",
    "film:demo": "node scripts/record-demo.mjs",
    "test:planted-bugs": "node scripts/planted-bugs.mjs",
    "test:parity": "tsx scripts/season/gen-traces.ts 20 60 && cd contracts/queue-v2 && cargo test sim_parity",
    "season:sweep": "tsx scripts/season/sweep.ts",
    "test:contract-v3": "cd contracts/queue-v3 && cargo test",
    "build:contract-v3": "cd contracts/queue-v3 && cargo build --target wasm32-unknown-unknown --release",
    "test:parity-v3": "QUEUE_SIM_RULES=v3 tsx scripts/season/gen-traces.ts && cd contracts/queue-v3 && cargo test sim_parity",
    "deploy:v3": "tsx scripts/v3/deploy.ts",
    "research:sim": "tsx scripts/research/queue-sim.ts --seeds 200",
    "proof:v3": "tsx scripts/v3/proof.ts",
    "proof:v3-client": "node scripts/v3/client-e2e.mjs",
    "proof:v3-table": "node scripts/v3/proof-table.mjs",
    "verify:v3": "node scripts/v3/verify.mjs",
    "verify:v3-deployed": "bash scripts/repro-build.sh contracts/queue-v3 market5.queue-demo.testnet",
    "test:client": "npm -w @queue/client run test",
    "queue": "node packages/client/src/cli.mjs",
    "queue:mcp": "node packages/client/src/mcp.mjs"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.65.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
