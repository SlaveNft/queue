{
  "name": "@queue/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QUEUE API, local settlement ledger, and worker agents",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "tsx src/cli/demo.ts"
  },
  "dependencies": {
    "@queue/core": "*",
    "@queue/ledger": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "near-api-js": "^7.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3"
  }
}
