# QUEUE runtime — copy to .env. Never commit .env.
QUEUE_PORT=8789
QUEUE_HOST=127.0.0.1
QUEUE_DB_PATH=./data/queue.db
QUEUE_WEB_ORIGIN=http://localhost:4178
QUEUE_VERSION=1.0.0
QUEUE_BUILD=local
QUEUE_LOG_LEVEL=info
# Set a token to require x-operator-token on every mutation (recommended when public).
QUEUE_OPERATOR_TOKEN=
# Set to 1 to disable writes while keeping the console readable.
QUEUE_READ_ONLY=0

# Testnet deploy (only used by scripts/deploy.mjs). Never commit keys.
QUEUE_NETWORK=testnet
QUEUE_RPC_URL=https://rpc.testnet.fastnear.com
QUEUE_PARENT_ACCOUNT_ID=
QUEUE_PARENT_PRIVATE_KEY=
QUEUE_CONTRACT_ID=
QUEUE_OWNER_PRIVATE_KEY=
QUEUE_OPERATOR_ACCOUNT_ID=
QUEUE_OPERATOR_PRIVATE_KEY=
QUEUE_TREASURY_ACCOUNT_ID=
QUEUE_TREASURY_PRIVATE_KEY=
QUEUE_BUYER_ACCOUNT_ID=
QUEUE_BUYER_PRIVATE_KEY=
QUEUE_MIRA_ACCOUNT_ID=
QUEUE_MIRA_PRIVATE_KEY=
QUEUE_ATLAS_ACCOUNT_ID=
QUEUE_ATLAS_PRIVATE_KEY=
QUEUE_VALE_ACCOUNT_ID=
QUEUE_VALE_PRIVATE_KEY=
QUEUE_JUNO_ACCOUNT_ID=
QUEUE_JUNO_PRIVATE_KEY=
# v1 proof, episode B: the account that plays the tight-deadline job.
QUEUE_ORION_ACCOUNT_ID=

# v2 season (scripts/season/*). Never commit keys.
# NEAR AI: the agents and the worker. Without a key the season runs on the labelled fallback policy.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# Comma-separated public testnet RPCs, rotated on rate limits.
QUEUE_RPC_URLS=
# Season deployment (scripts/season/setup.ts): parent account, contract account, deposit per agent (NEAR).
QUEUE_SEASON_PARENT=
QUEUE_SEASON_CONTRACT=
QUEUE_SEASON_DEPOSIT=
